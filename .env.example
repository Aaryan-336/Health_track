# ─── Database ───────────────────────────────────────────────────────────────
# Supabase: Project settings → Database → Connection string.
# DATABASE_URL is the *pooled* connection (port 6543, "Transaction" mode).
# DIRECT_URL is the direct one (port 5432) and is used only by prisma migrate.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Auth ───────────────────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=""

# The public origin of the deployment, e.g. https://bloom.vercel.app
NEXT_PUBLIC_APP_URL=""

# ─── Web push ───────────────────────────────────────────────────────────────
# npm run vapid  — generates the pair below.
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ─── Photo storage ──────────────────────────────────────────────────────────
# local    — the ./storage folder (development only)
# postgres — rows in the database, for hosts with no persistent disk
# supabase — a private Supabase Storage bucket (recommended in production)
STORAGE_DRIVER="local"
STORAGE_BUCKET="memories"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Background work ────────────────────────────────────────────────────────
# Shared secret for POST /api/v1/cron/tick. openssl rand -hex 24
CRON_SECRET=""

# ─── AI insights (optional) ─────────────────────────────────────────────────
# Leave empty to fall back to the deterministic, non-AI insight copy.
AI_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"
